# Copy to .env for local overrides. Never commit the real .env.
LACUNA_DATABASE_URL=sqlite:///./lacuna.db
# LACUNA_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# or models/sku110k-yolo11-s640-int8.onnx after scripts/quantize.py (the Docker default)
LACUNA_MODEL_PATH=models/sku110k-yolo11-s640.onnx
LACUNA_MIN_GAP_RATIO=0.8
# 0 = one thread per core. Use 1 when the container gets less than a full CPU
LACUNA_INFERENCE_THREADS=0
LACUNA_LOG_JSON=false
